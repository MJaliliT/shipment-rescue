# Export in your shell. No secrets are read from this example file.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN=
NIGHTSHIFT_MODEL=meterless/auto
# Zetaris instance-specific endpoint and read-only bearer token.
# Confirm endpoint and response contract from your instance's API docs first.
ZETARIS_QUERY_URL=
ZETARIS_TOKEN=
# Supported local JDBC path (in addition to the unverified HTTP transport above).
ZETARIS_JDBC_JAR=
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_USER=
ZETARIS_PASSWORD=
ZETARIS_SCHEMA=shipment_rescue
# Snapshot metadata: use these values only for the bundled synthetic cases.
SHIPMENT_AS_OF=2026-10-23T17:00:00Z
SHIPMENT_SYNTHETIC=true

# Optional hosted Nemotron compatibility profile (requires key saved in Nightshift).
# NIGHTSHIFT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIGHTSHIFT_THINKING=off
# NIGHTSHIFT_MIN_INTERVAL_MS=1600

# Optional operator-configured read-only refresh tables (same schema/asOf).
# If unset, a refresh rereads the original table. Never provide model-generated SQL.
# ZETARIS_REFRESH_WAREHOUSE_TABLE=warehouse_updates
# ZETARIS_REFRESH_CARRIER_TABLE=carrier_updates
# ZETARIS_REFRESH_INVENTORY_TABLE=inventory_updates
